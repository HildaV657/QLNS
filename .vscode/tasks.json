{
    "version": "2.0.0",
    "tasks": [
        {
        "type": "cppbuild",
        "label": "C/C++: g++.exe build active file",
        "command": "g++.exe",
        "args": [
            "-std=c++17",
            "-g",
            "${workspaceFolder}\\main.cpp",
            "-o",
            "${workspaceFolder}\\main.exe"
        ],
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": ["$gcc"],
        "group": { "kind": "build", "isDefault": true }
        }
    ]
}